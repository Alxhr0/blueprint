# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /
COPY system_files/global /system_files/global
COPY system_files/arch /system_files/arch

FROM archlinux:latest AS builder

RUN pacman -Syu --noconfirm \
    base-devel \
    git \
    rust \
    cargo \
    go-md2man \
    ostree \
    glibc \
    pkgconf \
    python-setuptools

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/builder-arch.sh

FROM archlinux:latest AS system

COPY --from=builder /output /

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-arch.sh

LABEL containers.bootc 1

# Note: bootc container lint is skipped for now because this is a minimal
# Arch-based example image. The base image triggers expected warnings:
#   - /boot is non-empty (kernel installed)
#   - /var contains pacman database and logs
#   - /run and /tmp have runtime content
# A production image should add proper tmpfiles.d entries, clean runtime
# directories, and configure ostree prepare-root.conf for composefs.

ARG ALMA_IMAGE="${ALMA_IMAGE:-quay.io/almalinuxorg/almalinux-bootc:10-kitten}"
ARG COMMON_IMAGE_REF="${COMMON_IMAGE_REF:-ghcr.io/projectbluefin/common:latest}"
ARG BREW_IMAGE_REF="${BREW_IMAGE_REF:-ghcr.io/ublue-os/brew:latest}"
ARG AKMODS_VERSION="${AKMODS_VERSION:-coreos-stable-43}"

# Desktop theming + shared system files (gsettings, dconf, umotd, uwelcome, ujust, etc.)
FROM ${COMMON_IMAGE_REF} AS common
# Homebrew + brew-bundle auto-install service
FROM ${BREW_IMAGE_REF} AS brew
# Prebuilt NVIDIA open akmods (kmods) for the target kernel — mirrors bluefin-lts.
FROM ghcr.io/ublue-os/akmods-nvidia-open:${AKMODS_VERSION} AS akmods_nvidia_open

FROM scratch AS ctx
COPY system_files/ /context/system_files
COPY build_files/almafin /context/build_scripts
COPY build_files/core /context/build_scripts/core
COPY brew/ /context/brew

# Pull the desktop/system files we need straight from the published common image
# so we always track upstream and only vendor AlmaFin-specific overrides below.
COPY --from=common /system_files/shared /context/common_shared
COPY --from=common /system_files/bluefin /context/bluefin_files
COPY --from=brew /system_files /context/brew_files

FROM ${ALMA_IMAGE}

ARG BREWFILE_REF="${BREWFILE_REF:-main}"
ARG IMAGE_NAME="${IMAGE_NAME:-blueprint}"
ARG IMAGE_VENDOR="${IMAGE_VENDOR:-huntedraven7}"
ARG SHA_HEAD_SHORT="${SHA_HEAD_SHORT:-deadbeef}"
ARG ENABLE_NVIDIA="${ENABLE_NVIDIA:-1}"
ARG FEDORA_AKMODS_VERSION="${FEDORA_AKMODS_VERSION:-43}"
ENV FEDORA_AKMODS_VERSION="${FEDORA_AKMODS_VERSION}"

RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=cache,dst=/var/cache \
  --mount=type=cache,dst=/var/log \
  --mount=type=bind,from=akmods_nvidia_open,src=/rpms,dst=/tmp/akmods-nvidia-open-rpms \
  --mount=type=bind,from=ctx,source=/context,target=/run/context \
  /run/context/build_scripts/build.sh

LABEL containers.bootc 1
RUN bootc container lint

ARG KERNEL_VERSION="${KERNEL_VERSION:-}"
ARG NVIDIA_DRIVER_VERSION="${NVIDIA_DRIVER_VERSION:-565.57.01}"

FROM quay.io/almalinuxorg/almalinux-bootc:10-kitten AS fetcher

# Download kernel and devel RPMs for the target kernel
RUN --mount=type=tmpfs,dst=/opt \
    --mount=type=tmpfs,dst=/tmp \
    dnf -y install dnf-plugins-core curl && \
    dnf config-manager --set-enabled crb && \
    dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm" && \
    dnf config-manager --set-enabled epel && \
    KVER="${KERNEL_VERSION:-$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1)}" && \
    mkdir -p /kernel-rpms && \
    dnf download -y --destdir=/kernel-rpms \
        "kernel-devel-${KVER}" \
        "kernel-${KVER}" \
        "kernel-core-${KVER}" \
        "kernel-modules-${KVER}" \
        "kernel-modules-core-${KVER}" \
        "kernel-modules-extra-${KVER}" && \
    dnf clean all

FROM quay.io/almalinuxorg/almalinux-bootc:10-kitten AS builder

# Install build dependencies
RUN --mount=type=tmpfs,dst=/opt \
    --mount=type=tmpfs,dst=/tmp \
    dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm" && \
    dnf config-manager --set-enabled epel && \
    dnf config-manager --add-repo=https://negativo17.org/repos/epel-nvidia.repo && \
    dnf -y install \
        gcc \
        make \
        rpm-build \
        elfutils-libelf-devel \
        dkms \
    && dnf clean all

# Copy kernel RPMs and install them
COPY --from=fetcher /kernel-rpms/ /kernel-rpms/
RUN --mount=type=tmpfs,dst=/opt \
    --mount=type=tmpfs,dst=/tmp \
    KVER="${KERNEL_VERSION:-$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1)}" && \
    dnf -y install /kernel-rpms/kernel-devel-*.rpm && \
    dnf -y install akmod-nvidia nvidia-driver nvidia-settings && \
    dnf clean all && \
    akmods --force --kernels "${KVER}" --akmod nvidia || true

# Find and collect the built RPMs
RUN mkdir -p /rpms /kernel-rpms && \
    KVER="${KERNEL_VERSION:-$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1)}" && \
    find /var/cache/akmods/nvidia -name "kmod-nvidia-*.rpm" -exec cp {} /rpms/ \; 2>/dev/null || true && \
    if rpm -q kmod-nvidia >/dev/null 2>&1; then \
        rpm -q --queryformat '%{SOURCERPM}' kmod-nvidia | head -1 | xargs -I{} dnf download --alldeps --destdir=/kernel-rpms {} 2>/dev/null || true; \
    fi && \
    cp /kernel-rpms/*.rpm /kernel-rpms/ 2>/dev/null || true

FROM scratch AS akmods-nvidia-open
COPY --from=builder /rpms /rpms
COPY --from=builder /kernel-rpms /kernel-rpms

ARG KERNEL_VERSION="${KERNEL_VERSION:-}"
ARG NVIDIA_DRIVER_VERSION="${NVIDIA_DRIVER_VERSION:-565.57.01}"

FROM quay.io/almalinuxorg/almalinux-bootc:10 AS builder

# Install build dependencies and enable repos
RUN --mount=type=tmpfs,dst=/opt \
    --mount=type=tmpfs,dst=/tmp \
    dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm" && \
    dnf config-manager --set-enabled epel && \
    dnf config-manager --add-repo=https://negativo17.org/repos/nvidia/fedora-44/x86_64/ && \
    dnf -y install \
        gcc \
        make \
        rpm \
        elfutils-libelf-devel \
        rpm-build \
        dkms \
    && dnf clean all

# Install kernel-devel for the running kernel (auto-detected)
RUN KVER=$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1) && \
    dnf -y install "kernel-devel-${KVER}" && \
    dnf -y install akmods-nvidia nvidia-driver nvidia-settings && \
    dnf clean all

# Build the NVIDIA kernel module for the running kernel
RUN KVER=$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1) && \
    akmods --force --kernels "${KVER}" nvidia || true

# Find and collect the built RPMs
RUN mkdir -p /rpms /kernel-rpms && \
    KVER=$(rpm -qa --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}' kernel | tail -1) && \
    find /var/cache/akmods/nvidia -name "kmod-nvidia-*.rpm" -exec cp {} /rpms/ \; 2>/dev/null || true && \
    if rpm -q kmod-nvidia >/dev/null 2>&1; then \
        rpm -q --queryformat '%{SOURCERPM}' kmod-nvidia | head -1 | xargs -I{} dnf download --alldeps --destdir=/kernel-rpms {} 2>/dev/null || true; \
    fi

FROM scratch AS akmods-nvidia-open
COPY --from=builder /rpms /rpms
COPY --from=builder /kernel-rpms /kernel-rpms

[Unit]
Description=Edward first boot setup (create initial user)
After=systemd-user-sessions.service
Before=ly@tty1.service
ConditionPathExists=!/etc/edward-firstboot.stamp

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/edward-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target

###############################################################################
# EDWARD CONTAINERFILE
###############################################################################
# edward image: Arch-based GNOME desktop (ublue/Bluefin-style). Layers a GNOME
# session, the OGC linux-ogc kernel + nvidia modules from the akmods cache, and
# the ublue @ublue-os/brew integration on top of the minimal arch-bootc base.
#
# Usage:
#   podman build -f containerfiles/edward/Containerfile.edward -t edward:testing .
#   just build-containerfile edward
#
# The project name is defined by IMAGE_NAME. Build scripts live in
# build/edward/ (plain pacman).
###############################################################################

###############################################################################
# OCI CONTEXT IMAGES (pinned; digests updated by Renovate)
###############################################################################
# Akmods cache for the OGC linux-ogc kernel: pinned kernel + headers packages
# and the nvidia modules built against them. Published by build-akmods.yml.
FROM ghcr.io/huntedraven7/akmods:ogc-x86_64 AS akmods

FROM ghcr.io/ublue-os/brew:latest@sha256:8f952ae54585db9f855a306ef365e13609ed7c7944b12b823ba7d5ce8e1a145b AS brew

###############################################################################
# CONTEXT STAGE
###############################################################################
FROM scratch AS ctx

COPY build/ /build
COPY custom/ /custom

# Copy system files (quadlets, launchers, desktop entries)
COPY system_files/ /system_files

# Copy from OCI containers to distinct subdirectories to avoid conflicts
COPY --from=brew /system_files /oci/brew
# Copy the akmods cache contents (kernel pkgs, nvidia modules) into /oci/akmods
COPY --from=akmods /var/cache/rpms /oci/akmods

###############################################################################
# BASE IMAGE
###############################################################################
# ghcr.io/huntedraven7/arch-bootc:testing — minimal Arch Linux bootc base
# (systemd, NetworkManager, podman, pacman + keyring). No desktop, no nvidia.
FROM ghcr.io/huntedraven7/arch-bootc:testing AS base

###############################################################################
# IMAGE IDENTITY
###############################################################################
ARG IMAGE_VENDOR="huntedraven7"
ARG UBLUE_IMAGE_TAG="stable"
ARG VERSION=""
ARG IMAGE_NAME="edward"

# Image metadata labels, mirroring projectbluefin/bluefin's set but for the
# Arch-based Edward desktop (ublue/oci layout).
LABEL containers.bootc="1"
LABEL org.opencontainers.image.title="${IMAGE_NAME}"
LABEL org.opencontainers.image.vendor="${IMAGE_VENDOR}"
LABEL org.opencontainers.image.description="An Arch Linux GNOME desktop in the Bluefin tradition: reliability, performance, and sustainability — with brew, flatpaks, and ujust-style recipes."
LABEL org.opencontainers.image.url="https://github.com/huntedraven7/blueprint"
LABEL org.opencontainers.image.source="https://github.com/huntedraven7/blueprint/blob/main/containerfiles/edward/Containerfile.edward"
LABEL org.opencontainers.image.version="${UBLUE_IMAGE_TAG}"
LABEL io.artifacthub.package.deprecated="false"
LABEL io.artifacthub.package.keywords="bootc,oci,linux,arch,gnome,universal-blue"
LABEL io.artifacthub.package.logo-url="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
LABEL io.artifacthub.package.readme-url="https://raw.githubusercontent.com/huntedraven7/blueprint/main/README.md"

# hadolint ignore=SC3040
RUN <<SET_NAME
#!/bin/bash
set -euo pipefail
echo "IMAGE_NAME=${IMAGE_NAME}"
# Write to /etc/environment for build scripts
echo "IMAGE_NAME=${IMAGE_NAME}" >> /etc/environment
SET_NAME

### MODIFICATIONS
## The RUN directives below mount the ctx stage, which includes build scripts,
## custom files, @ublue-os/brew, and the akmods cache.

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache/pacman/pkg \
    /ctx/build/10-build.sh

### CLEANUP
## Remove build artifacts before linting.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    --mount=type=tmpfs,dst=/boot \
    /ctx/build/clean-stage.sh

### /opt
## Makes /opt writeable by default.
RUN rm -rf /opt && ln -s /var/opt /opt

### INIT
## Required for bootc images
CMD ["/sbin/init"]

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint

ARG BLUEFIN_LTS_IMAGE="${BLUEFIN_LTS_IMAGE:-ghcr.io/projectbluefin/bluefin-lts-nvidia:testing}"

FROM scratch AS ctx

COPY system_files/ /context/system_files
COPY build_files/edward /context/build_scripts
COPY build_files/core /context/build_scripts/core
COPY brew/ /context/brew

FROM ${BLUEFIN_LTS_IMAGE}

ARG BREWFILE_REF="${BREWFILE_REF:-main}"
ARG IMAGE_NAME="${IMAGE_NAME:-blueprint}"
ARG IMAGE_VENDOR="${IMAGE_VENDOR:-huntedraven7}"
ARG SHA_HEAD_SHORT="${SHA_HEAD_SHORT:-deadbeef}"

RUN --mount=type=tmpfs,dst=/tmp \
  --mount=type=cache,dst=/var/cache \
  --mount=type=cache,dst=/var/log \
  --mount=type=bind,from=ctx,source=/context,target=/run/context \
  /run/context/build_scripts/build.sh

LABEL containers.bootc 1
RUN bootc container lint


FROM scratch AS ctx
COPY build_files /
COPY system_files/global /system_files/global
COPY system_files/edward /system_files/edward

FROM ghcr.io/huntedraven7/blueprint:arch

COPY --from=ghcr.io/ublue-os/brew:latest /system_files /

COPY brew/packages-edward.Brewfile /usr/share/ublue-os/homebrew/preinstall.d/packages-edward.Brewfile

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build-edward.sh

LABEL containers.bootc 1

RUN bootc container lint

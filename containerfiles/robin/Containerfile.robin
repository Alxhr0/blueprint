###############################################################################
# ROBIN CONTAINERFILE
###############################################################################
# robin image: Arch Linux KDE Plasma desktop with NVIDIA. Layers a KDE session,
# flatpak integration, and custom ujust recipes on top of arch-bootc.
#
# Usage:
#   podman build -f containerfiles/robin/Containerfile.robin -t robin:testing .
#   just build-containerfile robin
###############################################################################

###############################################################################
# CONTEXT STAGE
###############################################################################
FROM scratch AS ctx

COPY build/ /build
COPY custom/ /custom

COPY system_files/ /system_files/robin

###############################################################################
# BASE IMAGE
###############################################################################
# ghcr.io/huntedraven7/arch-bootc:testing — Arch Linux bootc base with NVIDIA
FROM ghcr.io/huntedraven7/arch-bootc:testing AS base

###############################################################################
# IMAGE IDENTITY
###############################################################################
ARG IMAGE_VENDOR="huntedraven7"
ARG UBLUE_IMAGE_TAG="testing"
ARG VERSION=""
ARG IMAGE_NAME="robin"

LABEL containers.bootc="1"
LABEL org.opencontainers.image.title="${IMAGE_NAME}"
LABEL org.opencontainers.image.vendor="${IMAGE_VENDOR}"
LABEL org.opencontainers.image.description="An Arch Linux KDE Plasma desktop with NVIDIA, flatpaks, and custom ujust recipes."
LABEL org.opencontainers.image.url="https://github.com/huntedraven7/blueprint"
LABEL org.opencontainers.image.source="https://github.com/huntedraven7/blueprint/blob/main/containerfiles/robin/Containerfile.robin"
LABEL org.opencontainers.image.version="${UBLUE_IMAGE_TAG}"
LABEL io.artifacthub.package.deprecated="false"
LABEL io.artifacthub.package.keywords="bootc,oci,linux,arch,kde,plasma,nvidia"
LABEL io.artifacthub.package.logo-url="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
LABEL io.artifacthub.package.readme-url="https://raw.githubusercontent.com/huntedraven7/blueprint/main/README.md"

RUN <<SET_NAME
#!/bin/bash
set -euo pipefail
echo "IMAGE_NAME=${IMAGE_NAME}"
echo "IMAGE_NAME=${IMAGE_NAME}" >> /etc/environment
SET_NAME

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build/10-build.sh

### CLEANUP
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build/clean-stage.sh

### /opt
RUN rm -rf /opt && ln -s /var/opt /opt

### CLEANUP RUNTIME DIRS
RUN rm -rf /tmp/.ICE-unix /tmp/.X11-unix /tmp/.XIM-unix /tmp/.font-unix

### INIT
CMD ["/sbin/init"]

### LINTING
RUN bootc container lint --fatal-warnings

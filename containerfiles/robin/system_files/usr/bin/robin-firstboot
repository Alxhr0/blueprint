#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Robin First Boot — create the initial user account
###############################################################################
# Runs once on the console before the SDDM greeter starts. The arch-bootc
# base ships no non-root user, so this prompts interactively on first boot.
# Skipped entirely when /etc/robin-firstboot.stamp exists or any regular
# user (UID 1000-59999) is already present.
###############################################################################

STAMP="/etc/robin-firstboot.stamp"

[[ -e "${STAMP}" ]] && exit 0

if awk -F: '$3 >= 1000 && $3 < 60000 { found = 1 } END { exit !found }' /etc/passwd; then
	echo "robin-firstboot: user account already present, skipping setup"
	touch "${STAMP}"
	exit 0
fi

echo ""
echo "=== Welcome to robin ==="
echo "No user account exists yet. Let's create one."
echo ""

USERNAME=""
while [[ ! "${USERNAME}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; do
	read -r -p "Enter a username: " USERNAME || exit 1
	if id "${USERNAME}" &>/dev/null; then
		echo "User '${USERNAME}' already exists, pick another."
		USERNAME=""
	fi
done

PASSWORD=""
PASSWORD_CONFIRM=""
while [[ -z "${PASSWORD}" || "${PASSWORD}" != "${PASSWORD_CONFIRM}" ]]; do
	read -r -s -p "Password for ${USERNAME}: " PASSWORD || exit 1
	echo ""
	read -r -s -p "Confirm password: " PASSWORD_CONFIRM || exit 1
	echo ""
	if [[ "${PASSWORD}" != "${PASSWORD_CONFIRM}" ]]; then
		echo "Passwords do not match, try again."
	fi
done

useradd -m -G wheel -s /bin/bash "${USERNAME}"
printf '%s:%s\n' "${USERNAME}" "${PASSWORD}" | chpasswd
unset PASSWORD PASSWORD_CONFIRM

touch "${STAMP}"
echo "Account '${USERNAME}' created (wheel/sudo enabled)."
echo "Starting the login screen..."

[Unit]
Description=Robin first boot setup (create initial user)
After=systemd-user-sessions.service
Before=sddm.service
ConditionPathExists=!/etc/robin-firstboot.stamp

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/robin-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target

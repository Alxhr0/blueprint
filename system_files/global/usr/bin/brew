#!/usr/bin/env bash
# Homebrew lives in /var/home/linuxbrew/.linuxbrew and /etc/profile.d/brew.sh
# only adds it to PATH at login time. On a fresh install brew-setup.service is
# still unpacking the tarball when the user session starts, so `brew` came up
# "command not found". This shim always resolves and hands off to the real
# binary (or explains what's happening) instead of failing with a bare
# "command not found".
if [[ -x /var/home/linuxbrew/.linuxbrew/bin/brew ]]; then
    exec /var/home/linuxbrew/.linuxbrew/bin/brew "$@"
fi
echo "brew: Homebrew is still being set up on first boot (brew-setup.service), try again in a moment" >&2
exit 127

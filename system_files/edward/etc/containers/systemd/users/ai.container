[Unit]
Description=Persistent Ubuntu AI container
Documentation=man:podman-systemd.unit(5)

[Container]
Image=ghcr.io/huntedraven7/blueprint:ai
ContainerName=ai
Exec=/usr/bin/sleep infinity
HostName=ai
PodmanArgs=--memory=512m --cpus=0.5 --gpus all
Volume=%h/.local/share/ai/home:/root:Z
Volume=%h/.local/share/ai/cache:/root/.cache:Z
Volume=%h/.ssh:/root/.ssh:ro
Volume=%h/.gitconfig:/root/.gitconfig:ro

[Service]
Restart=always
RestartSec=5
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/ai/home %h/.local/share/ai/cache
TimeoutStartSec=900

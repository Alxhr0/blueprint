#!/usr/bin/env bash
set -euo pipefail

NAME="${1:-ubuntu}"
UNIT="${NAME}.service"
ICON="applications-terminal"
DISPLAY_NAME="${NAME^}"

notify-send -i "${ICON}" "${DISPLAY_NAME}" "Please wait for your ${NAME} container"

systemctl --user daemon-reload
if ! systemctl --user start "${UNIT}"; then
    notify-send -u critical -i dialog-error "${DISPLAY_NAME}" "Failed to start ${NAME} container"
    exit 1
fi

for _ in $(seq 1 120); do
    if podman container exists "${NAME}" 2>/dev/null &&
        [[ "$(podman inspect -f '{{.State.Running}}' "${NAME}" 2>/dev/null)" == "true" ]]; then
        notify-send -i "${ICON}" "${DISPLAY_NAME}" "${NAME} container ready"
        exec ghostty --title="${NAME}" --class="${NAME}" -e podman exec -it "${NAME}" bash
    fi
    sleep 1
done

notify-send -u critical -i dialog-error "${DISPLAY_NAME}" "Timed out waiting for ${NAME} container"
exit 1

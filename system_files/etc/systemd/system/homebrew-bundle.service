[Unit]
Description=Install Homebrew packages from Brewfile
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '\
    BREWFILE="/usr/share/ublue-os/homebrew/preinstall.d/packages-${SUDO_USER:-${USER}}.Brewfile"; \
    if [ ! -f "$BREWFILE" ]; then \
        echo "No Brewfile found: $BREWFILE"; \
        exit 0; \
    fi; \
    BREW="$(command -v brew || true)"; \
    if [ -z "$BREW" ] && [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then \
        BREW=/home/linuxbrew/.linuxbrew/bin/brew; \
    fi; \
    if [ -z "$BREW" ]; then \
        echo "Homebrew could not be found"; \
        exit 1; \
    fi; \
    "$BREW" bundle --file="$BREWFILE"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target


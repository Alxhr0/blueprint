[Unit]
Description=Ephemeral Ubuntu NVIDIA container
Documentation=man:podman-systemd.unit(5)

[Container]
Image=ghcr.io/huntedraven7/blueprint:ubuntu-nvidia
ContainerName=ubuntu-nvidia
Exec=/usr/bin/sleep infinity
HostName=ubuntu-nvidia
PodmanArgs=--memory=512m --cpus=0.5

[Service]
TimeoutStartSec=900

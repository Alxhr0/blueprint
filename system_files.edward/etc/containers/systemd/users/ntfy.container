[Unit]
Description=ntfy push notification server
Documentation=https://ntfy.sh/docs/

[Container]
Image=docker.io/binwiederhier/ntfy:latest
ContainerName=ntfy
PublishPort=8081:80
Volume=%h/.local/share/ntfy:/var/lib/ntfy

[Service]
EnvironmentFile=-%h/.config/envs/ntfy/.env
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target

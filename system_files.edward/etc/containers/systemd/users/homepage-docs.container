[Unit]
Description=Homepage documentation site (nginx)
Documentation=https://gethomepage.dev/

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=homepage-docs
Network=homepage.network
PublishPort=3030:80
Volume=%h/src/homepage/nginx.conf:/etc/nginx/conf.d/default.conf:ro,Z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target

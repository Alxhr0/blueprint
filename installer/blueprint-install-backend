#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# Blueprint Server Installer — bootc backend
# Reads the config generated by blueprint-install and writes the image to disk.
###############################################################################

CFG_FILE="${1:-}"
TITLE="Blueprint Server Installer"

if [[ -z "$CFG_FILE" ]] || [[ ! -f "$CFG_FILE" ]]; then
    echo "Usage: blueprint-install-backend <config-file>" >&2
    exit 1
fi

# Load config
source "$CFG_FILE"

IMAGE_REF="${BLUEPRINT_IMAGE_REF:-ghcr.io/huntedraven7/blueprint:server}"

log() {
    local msg="$1"
    echo ":: $msg"
    # Also write to the console log for debugging
    logger -t blueprint-install "$msg"
}

die() {
    whiptail --title "$TITLE" --msgbox "\nInstallation failed:\n\n$1" 12 60
    exit 1
}

# ── Validate prerequisites ──────────────────────────────────────────────────
validate_prereqs() {
    log "Validating prerequisites..."

    if ! command -v bootc &>/dev/null; then
        die "bootc is not installed in the live environment."
    fi

    if [[ ! -b "$DISK" ]]; then
        die "Target disk ${DISK} does not exist or is not a block device."
    fi

    # Make sure the disk isn't mounted
    if mount | grep -q "^${DISK}"; then
        die "Target disk ${DISK} has mounted partitions. Unmount them first."
    fi
}

# ── Generate kickstart ──────────────────────────────────────────────────────
generate_kickstart() {
    local ks_file="/tmp/blueprint-install.ks"
    log "Generating kickstart file at ${ks_file}..."

    cat > "$ks_file" <<KSEOF
# Blueprint Server Installer — auto-generated kickstart
# Generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')

# System
lang en_US.UTF-8
keyboard us
timezone ${TIMEZONE} --utc

# Root password (hashed with openssl)
rootpw --plaintext "${ROOT_PASS}"

# Disk partitioning
clearpart --all --initlabel --drives=$(basename "$DISK")
KSEOF

    # Partitioning based on filesystem choice
    case "$FSTYPE" in
        btrfs)
            cat >> "$ks_file" <<KSEOF
part /boot/efi --fstype=efi --size=600 --ondisk=${DISK}
part /boot     --fstype=xfs   --size=1024 --ondisk=${DISK}
part btrfs.01  --fstype=btrfs --size=1  --ondisk=${DISK} --grow
volgroup rootvg btrfs.01
logvol /     --vgname=rootvg --name=root --fstype=btrfs --size=1 --grow
logvol /home --vgname=rootvg --name=home --fstype=btrfs --size=1 --grow
KSEOF
            ;;
        ext4)
            cat >> "$ks_file" <<KSEOF
part /boot/efi --fstype=efi  --size=600  --ondisk=${DISK}
part /boot     --fstype=ext4 --size=1024 --ondisk=${DISK}
part /        --fstype=ext4 --size=1     --ondisk=${DISK} --grow
KSEOF
            ;;
        xfs|*)
            cat >> "$ks_file" <<KSEOF
part /boot/efi --fstype=efi --size=600 --ondisk=${DISK}
part /boot     --fstype=xfs --size=1024 --ondisk=${DISK}
part /        --fstype=xfs --size=1    --ondisk=${DISK} --grow
KSEOF
            ;;
    esac

    # User creation
    if [[ "${CREATE_USER:-no}" == "yes" ]]; then
        cat >> "$ks_file" <<KSEOF
user --name=${USERNAME} --password="${USER_PASS}" --plaintext --gecos="${USER_FULLNAME}" --groups=wheel
KSEOF
    fi

    # Network
    cat >> "$ks_file" <<KSEOF
network --bootproto=dhcp --activate --hostname=${HOSTNAME}
KSEOF

    # Services
    SERVICES=""
    if [[ "${ENABLE_SSH:-no}" == "yes" ]]; then
        SERVICES+="sshd "
    fi
    if [[ "${ENABLE_COCKPIT:-no}" == "yes" ]]; then
        SERVICES+="cockpit "
    fi

    if [[ -n "$SERVICES" ]]; then
        echo "services --enabled=\"${SERVICES}\"" >> "$ks_file"
    fi

    # post-install: set hostname, SSH key, configure bootc
    cat >> "$ks_file" <<KSEOF

%post --log=/var/log/blueprint-install-post.log
set -x
# Set hostname
hostnamectl set-hostname ${HOSTNAME}

# SSH key for admin user
KSEOF

    if [[ "${CREATE_USER:-no}" == "yes" ]] && [[ -n "${SSH_KEY:-}" ]]; then
        cat >> "$ks_file" <<KSEOF
mkdir -p /home/${USERNAME}/.ssh
echo "${SSH_KEY}" > /home/${USERNAME}/.ssh/authorized_keys
chmod 700 /home/${USERNAME}/.ssh
chmod 600 /home/${USERNAME}/.ssh/authorized_keys
chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/.ssh
KSEOF
    fi

    # Enable services that weren't handled by kickstart
    if [[ "${ENABLE_COCKPIT:-no}" == "yes" ]]; then
        echo "systemctl enable --now cockpit.socket" >> "$ks_file"
    fi
    if [[ "${ENABLE_SSH:-no}" == "yes" ]]; then
        echo "systemctl enable --now sshd" >> "$ks_file"
    fi

    cat >> "$ks_file" <<KSEOF
%end
KSEOF

    log "Kickstart file generated."
}

# ── Run the installation ─────────────────────────────────────────────────────
run_install() {
    log "Starting bootc installation..."
    log "Image: ${IMAGE_REF}"
    log "Target: ${DISK}"

    # Pull the image first so we can show progress
    log "Pulling container image..."
    bootc pull --image "${IMAGE_REF}" 2>&1 | tail -5 || true

    # Run bootc install with kickstart
    bootc install \
        --target-device "${DISK}" \
        --kickstart "/tmp/blueprint-install.ks" \
        --image "${IMAGE_REF}" \
        --transport registry \
        --disable-selinux \
        --with-secureboot-auto-enroll \
        2>&1 | tee /var/log/blueprint-install.log || {
            # Fallback: try without some flags
            log "Retrying installation with fewer flags..."
            bootc install \
                --target-device "${DISK}" \
                --kickstart "/tmp/blueprint-install.ks" \
                --image "${IMAGE_REF}" \
                2>&1 | tee -a /var/log/blueprint-install.log
        }

    log "Installation completed successfully."
}

# ── Cleanup and reboot ───────────────────────────────────────────────────────
finish() {
    whiptail --title "$TITLE" --msgbox "\
Installation complete!\n\n\
The Blueprint server image has been written to ${DISK}.\n\n\
System hostname: ${HOSTNAME}\n\n\
Press OK to reboot into the installed system." 14 60

    log "Rebooting..."
    umount -a 2>/dev/null || true
    reboot -f
}

# ── Main ─────────────────────────────────────────────────────────────────────
main() {
    validate_prereqs

    # Show progress dialog while installing
    (
        generate_kickstart
        run_install
    ) | whiptail --title "$TITLE" --gauge "\
Installing Blueprint server to ${DISK}...\n\n\
This may take several minutes depending on network speed." 12 60 0

    finish
}

main

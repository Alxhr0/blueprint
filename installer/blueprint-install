#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# Blueprint Server Installer — ncurses TUI
# Walks the user through installing the Blueprint server image to bare metal.
###############################################################################

BACKEND="/usr/libexec/blueprint-install-backend"
TITLE="Blueprint Server Installer"
CFG_FILE="$(mktemp /tmp/blueprint-install.XXXXXX.conf)"
trap 'rm -f "$CFG_FILE"' EXIT

# ── Helpers ──────────────────────────────────────────────────────────────────
die()  { whiptail --title "$TITLE" --msgbox "\n$1" 8 60; exit 1; }
info() { whiptail --title "$TITLE" --msgbox "\n$1" 10 70; }

# ── Disk detection ───────────────────────────────────────────────────────────
get_disks() {
    lsblk -dno NAME,SIZE,MODEL | awk '$1 !~ /^(loop|sr|ram)/ { printf "/dev/%s  %s  %s\n", $1, $2, substr($0, index($0,$3)) }'
}

get_disk_devices() {
    lsblk -dno NAME | awk '$1 !~ /^(loop|sr|ram)/ { print "/dev/" $1 }'
}

# ── Step 1: Welcome ─────────────────────────────────────────────────────────
step_welcome() {
    whiptail --title "$TITLE" --msgbox "\
Welcome to the Blueprint Server Installer.\n\n\
This will install the Blueprint server image (bootc) to your\n\
target disk. The process will:\n\n\
  1. Select and partition the target disk\n\
  2. Configure system settings (hostname, timezone, etc.)\n\
  3. Create an admin user\n\
  4. Install the Blueprint server image to disk\n\n\
You will need:\n\
  - A target disk (will be wiped)\n\
  - Network access (for pulling the container image)\n\n\
Press OK to begin." 18 72
}

# ── Step 2: Disk selection ───────────────────────────────────────────────────
step_disk() {
    mapfile -t DISK_LIST < <(get_disk_devices)
    mapfile -t DISK_INFO < <(get_disks)

    if [[ ${#DISK_LIST[@]} -eq 0 ]]; then
        die "No disks detected. Please connect a target disk and restart."
    fi

    MENU_ITEMS=()
    for i in "${!DISK_LIST[@]}"; do
        MENU_ITEMS+=("${DISK_LIST[$i]}" "${DISK_INFO[$i]}")
    done

    DISK=$(whiptail --title "$TITLE" --menu "\nSelect the target disk for installation:" 20 72 12 "${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3) || die "Installation cancelled."
    echo "DISK=${DISK}" >> "$CFG_FILE"

    # Confirm wipe
    whiptail --title "$TITLE" --yesno "\
WARNING: All data on ${DISK} will be ERASED.\n\n\
Disk: $(lsblk -dno SIZE,MODEL "${DISK}" 2>/dev/null || echo "$DISK")\n\n\
Are you sure you want to continue?" 12 60 || die "Installation cancelled."
}

# ── Step 3: Filesystem ──────────────────────────────────────────────────────
step_filesystem() {
    FSTYPE=$(whiptail --title "$TITLE" --menu "\nSelect root filesystem type:" 14 60 4 \
        "xfs"    "XFS (default, recommended for servers)" \
        "ext4"   "ext4 (traditional, widely compatible)" \
        "btrfs"  "Btrfs (snapshots, compression)" \
        3>&1 1>&2 2>&3) || die "Installation cancelled."
    echo "FSTYPE=${FSTYPE}" >> "$CFG_FILE"
}

# ── Step 4: Hostname ─────────────────────────────────────────────────────────
step_hostname() {
    HOSTNAME=$(whiptail --title "$TITLE" --inputbox "\nEnter the system hostname:" 10 60 "blueprint-server" 3>&1 1>&2 2>&3) || die "Installation cancelled."

    if [[ -z "$HOSTNAME" ]]; then
        die "Hostname cannot be empty."
    fi

    if [[ ! "$HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]]; then
        die "Invalid hostname: must contain only letters, digits, hyphens, and dots."
    fi

    echo "HOSTNAME=${HOSTNAME}" >> "$CFG_FILE"
}

# ── Step 5: Timezone ─────────────────────────────────────────────────────────
step_timezone() {
    # Offer common timezones; fall back to region selection
    TIMEZONE=$(whiptail --title "$TITLE" --menu "\nSelect timezone:" 20 72 12 \
        "America/New_York"       "Eastern Time (US & Canada)" \
        "America/Chicago"       "Central Time (US & Canada)" \
        "America/Denver"        "Mountain Time (US & Canada)" \
        "America/Los_Angeles"   "Pacific Time (US & Canada)" \
        "UTC"                   "Coordinated Universal Time" \
        "Europe/London"         "GMT / UK" \
        "Europe/Berlin"         "Central European Time" \
        "Asia/Tokyo"            "Japan Standard Time" \
        "Asia/Shanghai"         "China Standard Time" \
        "Australia/Sydney"      "Australian Eastern Time" \
        "custom"                "Enter a custom timezone" \
        3>&1 1>&2 2>&3) || die "Installation cancelled."

    if [[ "$TIMEZONE" == "custom" ]]; then
        TIMEZONE=$(whiptail --title "$TITLE" --inputbox "\nEnter timezone (e.g. America/New_York):" 10 60 "UTC" 3>&1 1>&2 2>&3) || die "Installation cancelled."
    fi

    echo "TIMEZONE=${TIMEZONE}" >> "$CFG_FILE"
}

# ── Step 6: Root password ────────────────────────────────────────────────────
step_root_password() {
    while true; do
        ROOT_PASS=$(whiptail --title "$TITLE" --passwordbox "\nEnter root password:" 10 60 3>&1 1>&2 2>&3) || die "Installation cancelled."
        ROOT_PASS2=$(whiptail --title "$TITLE" --passwordbox "\nConfirm root password:" 10 60 3>&1 1>&2 2>&3) || die "Installation cancelled."

        if [[ -z "$ROOT_PASS" ]]; then
            whiptail --title "$TITLE" --msgbox "\nRoot password cannot be empty." 8 50
            continue
        fi

        if [[ "$ROOT_PASS" != "$ROOT_PASS2" ]]; then
            whiptail --title "$TITLE" --msgbox "\nPasswords do not match. Try again." 8 50
            continue
        fi

        break
    done

    echo "ROOT_PASS=${ROOT_PASS}" >> "$CFG_FILE"
}

# ── Step 7: User creation ────────────────────────────────────────────────────
step_user() {
    CREATE_USER=$(whiptail --title "$TITLE" --yesno "\nCreate a regular user with sudo access?" 10 60 && echo "yes" || echo "no")
    echo "CREATE_USER=${CREATE_USER}" >> "$CFG_FILE"

    if [[ "$CREATE_USER" == "yes" ]]; then
        USERNAME=$(whiptail --title "$TITLE" --inputbox "\nUsername:" 10 60 "" 3>&1 1>&2 2>&3) || die "Installation cancelled."

        if [[ -z "$USERNAME" ]] || [[ ! "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
            die "Invalid username. Must start with a letter or underscore, contain only lowercase letters, digits, hyphens, and underscores."
        fi

        USER_FULLNAME=$(whiptail --title "$TITLE" --inputbox "\nFull name (optional):" 10 60 "" 3>&1 1>&2 2>&3) || die "Installation cancelled."

        while true; do
            USER_PASS=$(whiptail --title "$TITLE" --passwordbox "\nPassword for ${USERNAME}:" 10 60 3>&1 1>&2 2>&3) || die "Installation cancelled."
            USER_PASS2=$(whiptail --title "$TITLE" --passwordbox "\nConfirm password:" 10 60 3>&1 1>&2 2>&3) || die "Installation cancelled."

            if [[ -z "$USER_PASS" ]]; then
                whiptail --title "$TITLE" --msgbox "\nPassword cannot be empty." 8 50
                continue
            fi

            if [[ "$USER_PASS" != "$USER_PASS2" ]]; then
                whiptail --title "$TITLE" --msgbox "\nPasswords do not match." 8 50
                continue
            fi

            break
        done

        echo "USERNAME=${USERNAME}" >> "$CFG_FILE"
        echo "USER_FULLNAME=${USER_FULLNAME}" >> "$CFG_FILE"
        echo "USER_PASS=${USER_PASS}" >> "$CFG_FILE"
    fi
}

# ── Step 8: SSH key ──────────────────────────────────────────────────────────
step_ssh_key() {
    SSH_KEY=$(whiptail --title "$TITLE" --inputbox "\
Enter an SSH public key for the admin user (optional).\n\n\
You can paste your full public key (ssh-rsa AAAA...).\n\
Leave empty to skip." 14 72 "" 3>&1 1>&2 2>&3) || die "Installation cancelled."

    echo "SSH_KEY=${SSH_KEY}" >> "$CFG_FILE"
}

# ── Step 9: Services ─────────────────────────────────────────────────────────
step_services() {
    ENABLE_SSH=$(whiptail --title "$TITLE" --yesno "\nEnable SSH server (sshd)?" 10 60 && echo "yes" || echo "no")
    echo "ENABLE_SSH=${ENABLE_SSH}" >> "$CFG_FILE"

    ENABLE_COCKPIT=$(whiptail --title "$TITLE" --yesno "\nEnable Cockpit web console?" 10 60 && echo "yes" || echo "no")
    echo "ENABLE_COCKPIT=${ENABLE_COCKPIT}" >> "$CFG_FILE"
}

# ── Step 10: Summary ─────────────────────────────────────────────────────────
step_summary() {
    source "$CFG_FILE"

    SUMMARY="Blueprint Server — Installation Summary\n"
    SUMMARY+="══════════════════════════════════════════\n\n"
    SUMMARY+="Target disk:     ${DISK}\n"
    SUMMARY+="Filesystem:      ${FSTYPE}\n"
    SUMMARY+="Hostname:        ${HOSTNAME}\n"
    SUMMARY+="Timezone:        ${TIMEZONE}\n"
    SUMMARY+="Root user:       configured\n"

    if [[ "${CREATE_USER:-no}" == "yes" ]]; then
        SUMMARY+="Admin user:      ${USERNAME} (${USER_FULLNAME:-no fullname})\n"
    else
        SUMMARY+="Admin user:      (none)\n"
    fi

    SUMMARY+="SSH key:         $([ -n "${SSH_KEY:-}" ] && echo "configured" || echo "none")\n"
    SUMMARY+="SSH server:      ${ENABLE_SSH}\n"
    SUMMARY+="Cockpit:         ${ENABLE_COCKPIT}\n"
    SUMMARY+="\n══════════════════════════════════════════\n"
    SUMMARY+="Press YES to begin installation."

    whiptail --title "$TITLE" --yesno "\n${SUMMARY}" 24 72 || die "Installation cancelled."
}

# ── Main ─────────────────────────────────────────────────────────────────────
main() {
    # We need root
    if [[ "${EUID}" -ne 0 ]]; then
        echo "This installer must be run as root." >&2
        exit 1
    fi

    # Ensure whiptail is available
    if ! command -v whiptail &>/dev/null; then
        echo "whiptail is required but not installed." >&2
        exit 1
    fi

    step_welcome
    step_disk
    step_filesystem
    step_hostname
    step_timezone
    step_root_password
    step_user
    step_ssh_key
    step_services
    step_summary

    # Hand off to the backend
    "$BACKEND" "$CFG_FILE"
}

main "$@"

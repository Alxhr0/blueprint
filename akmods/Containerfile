# Cached kernel modules for the OGC Arch kernel (linux-ogc).
#
# A personal, Arch-native mirror of ublue-os/akmods: one pinned kernel, modules
# built against it (nvidia via the official nvidia-open-dkms package, zfs from
# the upstream OpenZFS source), and a scratch cache image carrying the pinned
# kernel packages + the built .ko modules so downstream bootc images can COPY
# them with certainty that nvidia/zfs match the exact linux-ogc release.
#
# Build:
#   podman build --build-arg OGC_IMAGE=ghcr.io/opengamingcollective/kernel-packages-arch:latest .
#
# Build args:
#   OGC_IMAGE      the pinned OGC Arch kernel OCI artifact (tag or digest)
#   ZFS_MINOR_VERSION   optional zfs release-series pin (e.g. "2.4")
FROM docker.io/archlinux:base-devel AS prep

ARG OGC_IMAGE=ghcr.io/opengamingcollective/kernel-packages-arch:latest
ARG ZFS_MINOR_VERSION=
ENV OGC_IMAGE=${OGC_IMAGE} \
    ZFS_MINOR_VERSION=${ZFS_MINOR_VERSION}

COPY build_files/prep /tmp/
RUN --mount=type=cache,target=/var/cache/pacman/pkg \
    bash /tmp/fetch-kernel.sh && \
    bash /tmp/build-prep.sh

FROM prep AS nvidia
COPY build_files/nvidia /tmp/
RUN --mount=type=cache,target=/var/cache/pacman/pkg \
    bash /tmp/build-kmod-nvidia.sh

FROM nvidia AS zfs
COPY build_files/zfs /tmp/
RUN --mount=type=cache,target=/var/cache/pacman/pkg \
    bash /tmp/build-kmod-zfs.sh

FROM zfs AS post
COPY build_files/post /tmp/
RUN --mount=type=cache,target=/var/cache/pacman/pkg \
    bash /tmp/build-post.sh

# Final cache image: pinned kernel packages + built modules, raw filesystem.
FROM scratch AS cache
COPY --from=post /var/cache/rpms /var/cache/rpms

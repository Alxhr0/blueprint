set dotenv-load := false

# Local Justfile for the Arch akmods cache (OGC linux-ogc kernel).
# Self-contained sub-project; run recipes from this directory.

podman := 'podman'
reg := 'ghcr.io/huntedraven7'
akmods_name := 'akmods'
_jd := justfile_directory()

# Local image name
local_image := 'localhost/' + akmods_name

# Build the akmods cache image locally (cache stage = kernel pkgs + modules).
[group('Build')]
build:
    #!/usr/bin/env bash
    set -euo pipefail
    # Kernel pin lives only in images.yaml (single source of truth).
    OGC_IMAGE="$(bash "{{ _jd }}/scripts/ogc-image.sh")"
    {{ podman }} build -f "{{ _jd }}/Containerfile" \
        --build-arg OGC_IMAGE="${OGC_IMAGE}" \
        --target cache \
        --tag "{{ local_image }}:ogc-x86_64" \
        "{{ _jd }}"

# Push the cache image to the registry (kernels are pinned in images.yaml).
[group('Registry')]
@login:
    #!/usr/bin/env bash
    {{ podman }} login {{ reg }} -u "${REGISTRY_ACTOR:?}" -p "${REGISTRY_TOKEN:?}"

[group('Registry')]
push: build
    #!/usr/bin/env bash
    set -eou pipefail
    for tag in ogc-x86_64; do
        {{ podman }} push "{{ local_image }}:${tag}" "{{ reg }}/{{ akmods_name }}:${tag}"
    done

# Remove local build cache.
[group('Utility')]
clean:
    {{ podman }} image rm -f "{{ local_image }}:ogc-x86_64" 2>/dev/null || true
